{
  "name": "calcula-rfc",
  "version": "3.0.0",
  "type": "module",
  "description": "Calcula y valida el RFC de personas fisicas en Mexico (homoclave y digito verificador, algoritmo del SAT). Sin dependencias.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.js --format esm,cjs --dts --target node20 --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "npm test && npm run lint && npm run build"
  },
  "keywords": [
    "rfc",
    "sat",
    "mexico",
    "homoclave",
    "digito-verificador",
    "validacion",
    "contribuyente",
    "persona-fisica"
  ],
  "author": "Gerardo Lucero",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GerardoLucero/calcula-rfc.git"
  },
  "bugs": {
    "url": "https://github.com/GerardoLucero/calcula-rfc/issues"
  },
  "homepage": "https://github.com/GerardoLucero/calcula-rfc#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^8.57.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.test.{js,ts}",
      "!src/**/*.spec.{js,ts}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
